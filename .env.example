DATABASE_URL=postgres://cursor_sync:cursor_sync@postgres:5432/cursor_sync
JWT_SECRET=change-me-to-a-long-random-string
PORT=8100

# Public website origin for verification links (API only). No trailing slash required.
# PUBLIC_WEB_ORIGIN=https://staging.sync.bergamota.dev

# Resend (API server). Required to send verification emails; signup still succeeds if unset.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# RESEND_FROM_NAME=Cursor Sync

# Website (Vite). Unset in production = fail-closed auth (no relative /auth on static host).
# Local dev can omit this and use the Vite /auth proxy, or set http://localhost:8100
# Staging default when unset at build: https://api-staging-sync.bergamota.dev
# VITE_API_URL=http://localhost:8100

# Optional public hostname shown in the site footer (default: sync.bergamota.dev)
# VITE_PUBLIC_SITE_HOST=sync.bergamota.dev

# R2 temp credentials (POST /v1/storage/credentials). All required to mint; missing any → 503.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=cursor-sync-lab
R2_PARENT_ACCESS_KEY_ID=
R2_PARENT_SECRET_ACCESS_KEY=
