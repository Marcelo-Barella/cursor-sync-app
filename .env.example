DATABASE_URL=postgres://cursor_sync:cursor_sync@postgres:5432/cursor_sync
JWT_SECRET=change-me-to-a-long-random-string
PORT=8100

# Docker compose: host address for the API port mapping (container port 8100). Use 127.0.0.1 on VPS when only localhost should reach the API.
# API_BIND=0.0.0.0

# API image build metadata (docker compose build args; surfaced on GET /health).
# GIT_SHA=local-dev
# APP_VERSION=0.1.0

# Trusted reverse-proxy hops for X-Forwarded-For on GET /v1/keys rate limiting (default 1).
# Must match how many entries the API sees in X-Forwarded-For (Express "trust proxy" semantics):
#   Staging: Cloudflare edge → cloudflared (tunnel) → docker-proxy → API → one XFF entry → hops=1
#   1 = single hop in XFF (Caddy only, or tunnel + compose as on staging)
#   2 = two hops in XFF (e.g. Cloudflare → Caddy when both append)
# TRUSTED_PROXY_HOPS=1

# Public website origin for verification links (API only). Required to build verify URLs; no trailing slash required.
# PUBLIC_WEB_ORIGIN=https://staging.cursor-sync.com

# Resend (API server). Required to send verification emails; signup still succeeds if unset.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# RESEND_FROM_NAME=Cursor Sync

# Comma-separated browser origins allowed for CORS (e.g. staging website). Unset = reflect request Origin.
# CORS_ALLOWED_ORIGINS=https://staging.cursor-sync.com

# Website (Vite build / dev). Required for production/staging builds; no fallback API host.
# Local compose default in this file:
VITE_API_URL=http://localhost:8100

# Optional public hostname shown in the site footer (defaults to current browser hostname when unset).
# VITE_PUBLIC_SITE_HOST=staging.cursor-sync.com

# R2 temp credentials (POST /v1/storage/credentials). All required to mint; missing any → 503.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_BUCKET=cursor-sync-lab
R2_PARENT_ACCESS_KEY_ID=
R2_PARENT_SECRET_ACCESS_KEY=
