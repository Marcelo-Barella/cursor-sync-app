server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  add_header Content-Security-Policy "__CONTENT_SECURITY_POLICY__" always;
  add_header X-Frame-Options "__X_FRAME_OPTIONS__" always;
  add_header Referrer-Policy "__REFERRER_POLICY__" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Permissions-Policy "__PERMISSIONS_POLICY__" always;

  location / {
    try_files $uri $uri/ /index.html;
  }
}